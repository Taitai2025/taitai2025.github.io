import BB.NonlinearStep

/-! # Actual local nonlinear BB iteration

These theorems use a supplied common frozen certificate.  The certificate is
constructed from the Hessian by `BB.Operator.frozen_interval_certificate`; the
final wrapper can therefore discharge that input without assuming the desired
nonlinear recurrence.
-/

noncomputable section
namespace BB.Local

open Set Metric BB.Secant BB.Gluing MeasureTheory
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {g : E → E} {D : E → E →L[ℝ] E} {H : E →L[ℝ] E}
  {a b R : ℝ} {omega : ℝ → ℝ}

/-- The frozen map is in the enlarged pair cone for every interpolation choice. -/
theorem GradientControl.frozen_mem (C : GradientControl g D H a b R omega)
    {M : ℝ} (hM : 1+(b+a/2)*(2/a) ≤ M)
    (eta : Set.Icc (0 : ℝ) 1) (z : E × E) : frozenMap H eta z ∈ pairCone M := by
  have ha := C.a_pos
  have hb : 0 < b := ha.trans_le C.a_le_b
  have hB : 0 ≤ 2/a := div_nonneg (by norm_num) ha.le
  have hL : 0 ≤ b+a/2 := by positivity
  have hM1 : 1 ≤ M := (le_add_of_nonneg_right (mul_nonneg hL hB)).trans hM
  change ‖z.2-blend eta.1 z.1 (H z.1) • H z.2‖ ≤ M*‖z.2‖
  by_cases hu : z.1=0
  · simp only [hu,map_zero,blend,bb1,bb2,norm_zero,zero_pow (by norm_num : 2 ≠ 0),
      inner_zero_left,div_zero,mul_zero,add_zero,zero_smul,sub_zero]
    exact le_mul_of_one_le_left (norm_nonneg _) hM1
  · have Cs : Control a b 0 z.1 (H z.1) (H z.1) := {
      a_pos := ha
      a_le_b := C.a_le_b
      delta_nonneg := le_refl 0
      delta_le_half := (half_pos ha).le
      s_ne_zero := hu
      coercive := C.coercive _
      base_norm := (H.le_opNorm _).trans (mul_le_mul_of_nonneg_right C.operator_bound (norm_nonneg _))
      error := by simp }
    have hbeta := Cs.blend_bounds eta.2.1 eta.2.2
    have hH : ‖H z.2‖ ≤ b*‖z.2‖ :=
      (H.le_opNorm _).trans (mul_le_mul_of_nonneg_right C.operator_bound (norm_nonneg _))
    have ht := norm_sub_le z.2 (blend eta.1 z.1 (H z.1) • H z.2)
    rw [norm_smul,Real.norm_eq_abs,abs_of_pos hbeta.1] at ht
    have hm := mul_le_mul hbeta.2 hH (norm_nonneg _) hB
    have hcoeff : 1+b*(2/a) ≤ M := by
      have hh := mul_le_mul_of_nonneg_right (show b ≤ b+a/2 by linarith only [ha]) hB
      linarith only [hh,hM]
    have hc := mul_le_mul_of_nonneg_right hcoeff (norm_nonneg z.2)
    nlinarith only [ht,hm,hc]

theorem certificate_value_zero {M c : ℝ}
    (V : Certificate (frozenMap H) (pairCone (E := E) M) c) : V.value 0 = 0 := by
  have hl := V.lower 0 (zero_mem_pairCone M)
  have hu := V.upper 0 (zero_mem_pairCone M)
  simp only [norm_zero,mul_zero] at hl hu
  exact le_antisymm hu hl

/-- The actual local step satisfies the critical Lyapunov perturbation recurrence. -/
theorem GradientControl.actual_lyapunov_step (C : GradientControl g D H a b R omega)
    {M c : ℝ} (V : Certificate (frozenMap H) (pairCone (E := E) M) c)
    (hM : 1+(b+a/2)*(2/a) ≤ M)
    {x y z : E} {alpha beta : ℝ}
    (hx : ‖x‖ < R) (hy : ‖y‖ < R) (hz : ‖z‖ < R) (halpha : 0 < alpha)
    (hprev : y=x-alpha • g x) (hnext : z=y-beta • g y)
    (hchoice : intervalChoice g x y beta) (hcone : (g x,g y) ∈ pairCone M) :
    (g y,g z) ∈ pairCone M ∧
      V.value (g y,g z) ≤
        (c+V.lipConstant*perturbationFactor a b*
          omega (radiusFactor a*V.value (g x,g y)))*V.value (g x,g y) := by
  have hcone' := C.next_cone hx hy hz halpha hprev hnext hchoice hM
  obtain ⟨eta,herror⟩ := C.actual_pair_error hx hy hz halpha hprev hnext hchoice
  refine ⟨hcone',?_⟩
  exact lyapunov_perturbation V (perturbationFactor_nonneg C.a_pos C.a_le_b)
    (radiusFactor_pos C.a_pos).le omega C.monotone C.nonnegative eta hcone hcone'
    (C.frozen_mem hM eta _) herror

/-- Positive actual secant denominators, proved from the local derivative bound. -/
theorem GradientControl.secant_denominators (C : GradientControl g D H a b R omega)
    {x y : E} {alpha : ℝ} (hx : ‖x‖ < R) (hy : ‖y‖ < R)
    (halpha : 0 < alpha) (hprev : y=x-alpha • g x) (hzero : g x ≠ 0) :
    0 < ⟪y-x,g y-g x⟫_ℝ ∧ 0 < ‖g y-g x‖^2 := by
  have hs := C.secant hx hy (secant_ne_zero halpha hprev hzero)
  have hsn : 0 < ‖y-x‖ := norm_pos_iff.mpr hs.s_ne_zero
  have hi : 0 < ⟪y-x,g y-g x⟫_ℝ :=
    (mul_pos (half_pos C.a_pos) (sq_pos_of_pos hsn)).trans_le hs.actual_coercive
  have hn := norm_lower_of_inner (half_pos C.a_pos) hs.s_ne_zero hs.actual_coercive
  exact ⟨hi,sq_pos_of_pos ((mul_pos (half_pos C.a_pos) hsn).trans_le hn)⟩

/-- A joint induction proves invariance before using the nonlinear recurrence.
It carries the pair cone as well as the point-ball condition, including the
first pair generated by a merely bounded positive initial step. -/
theorem GradientControl.local_bootstrap (C : GradientControl g D H a b R omega)
    {M c : ℝ} (V : Certificate (frozenMap H) (pairCone (E := E) M) c)
    (hM : 1+(b+a/2)*(2/a) ≤ M)
    (x : ℕ → E) (alpha : ℕ → ℝ)
    (halpha : ∀ n, 0 < alpha n)
    (hstep : ∀ n, x (n+1)=x n-alpha n • g (x n))
    (hchoice : ∀ n, intervalChoice g (x n) (x (n+1)) (alpha (n+1)))
    {epsilon gamma : ℝ} (hgamma : 0 ≤ gamma) (hgamma1 : gamma ≤ 1)
    (hx0 : ‖x 0‖ < R) (hx1 : ‖x 1‖ < R)
    (hcone0 : (g (x 0),g (x 1)) ∈ pairCone M)
    (hinit : V.value (g (x 0),g (x 1)) ≤ epsilon)
    (hball : radiusFactor a*epsilon < R)
    (hsmall : c+V.lipConstant*perturbationFactor a b*omega (radiusFactor a*epsilon) ≤ gamma) :
    (∀ n, ‖x n‖ < R) ∧
    (∀ n, (g (x n),g (x (n+1))) ∈ pairCone M) ∧
    (∀ n, V.value (g (x n),g (x (n+1))) ≤ gamma^n*V.value (g (x 0),g (x 1))) ∧
    (∀ n, V.value (g (x (n+1)),g (x (n+2))) ≤
      (c+V.lipConstant*perturbationFactor a b*
        omega (radiusFactor a*V.value (g (x n),g (x (n+1)))))*
        V.value (g (x n),g (x (n+1)))) := by
  let v := fun n => V.value (g (x n),g (x (n+1)))
  have hB : 0 ≤ radiusFactor a := (radiusFactor_pos C.a_pos).le
  have hD : 0 ≤ V.lipConstant*perturbationFactor a b :=
    mul_nonneg V.lipConstant_nonneg (perturbationFactor_nonneg C.a_pos C.a_le_b)
  have hv0 : 0 ≤ v 0 := (norm_nonneg _).trans (V.lower _ hcone0)
  have joint : ∀ n, ‖x n‖ < R ∧ ‖x (n+1)‖ < R ∧
      (g (x n),g (x (n+1))) ∈ pairCone M ∧ v n ≤ gamma^n*v 0 := by
    intro n
    induction n with
    | zero => exact ⟨hx0,hx1,hcone0,by simp⟩
    | succ n ih =>
      have hvn : 0 ≤ v n := (norm_nonneg _).trans (V.lower _ ih.2.2.1)
      have hve : v n ≤ epsilon :=
        (ih.2.2.2.trans (by nlinarith only [pow_le_one n hgamma hgamma1,hv0])).trans hinit
      have hnext := C.next_bound ih.1 ih.2.1 (halpha n) (hstep n)
        (hstep (n+1)) (hchoice n)
      have hxn : ‖x (n+2)‖ < R := by
        apply hnext.trans_lt
        exact (mul_le_mul_of_nonneg_left
          ((V.lower _ ih.2.2.1).trans hve) hB).trans_lt hball
      obtain ⟨hcone',hrec⟩ := C.actual_lyapunov_step V hM ih.1 ih.2.1 hxn
        (halpha n) (hstep n) (hstep (n+1)) (hchoice n) ih.2.2.1
      have hcoef : c+V.lipConstant*perturbationFactor a b*omega (radiusFactor a*v n) ≤ gamma := by
        have ho := mul_le_mul_of_nonneg_left
          (C.monotone (mul_le_mul_of_nonneg_left hve hB)) hD
        linarith only [ho,hsmall]
      have hvs : v (n+1) ≤ gamma*v n := hrec.trans (mul_le_mul_of_nonneg_right hcoef hvn)
      refine ⟨ih.2.1,by simpa only [Nat.add_assoc] using hxn,hcone',?_⟩
      calc
        v (n+1) ≤ gamma*v n := hvs
        _ ≤ gamma*(gamma^n*v 0) := mul_le_mul_of_nonneg_left ih.2.2.2 hgamma
        _ = gamma^(n+1)*v 0 := by rw [pow_succ]; ring
  refine ⟨fun n => (joint n).1,fun n => (joint n).2.2.1,fun n => (joint n).2.2.2,?_⟩
  intro n
  exact (C.actual_lyapunov_step V hM (joint n).1 (joint n).2.1 (joint (n+1)).2.1
    (halpha n) (hstep n) (hstep (n+1)) (hchoice n) (joint n).2.2.1).2

/-- Exact critical factor under the Dini integral, uniform over every actual
secant-interval choice.  No recurrence estimate is an assumption. -/
theorem GradientControl.critical_local_rate (C : GradientControl g D H a b R omega)
    {M c : ℝ} (V : Certificate (frozenMap H) (pairCone (E := E) M) c)
    (hc : 0 < c) (hM : 1+(b+a/2)*(2/a) ≤ M)
    (x : ℕ → E) (alpha : ℕ → ℝ)
    (halpha : ∀ n, 0 < alpha n)
    (hstep : ∀ n, x (n+1)=x n-alpha n • g (x n))
    (hchoice : ∀ n, intervalChoice g (x n) (x (n+1)) (alpha (n+1)))
    {epsilon gamma : ℝ} (hepsilon : 0 < epsilon) (hgamma : 0 < gamma) (hgamma1 : gamma < 1)
    (hx0 : ‖x 0‖ < R) (hx1 : ‖x 1‖ < R)
    (hcone0 : (g (x 0),g (x 1)) ∈ pairCone M)
    (hinit : V.value (g (x 0),g (x 1)) ≤ epsilon)
    (hball : radiusFactor a*epsilon < R)
    (hsmall : c+V.lipConstant*perturbationFactor a b*omega (radiusFactor a*epsilon) ≤ gamma)
    (hDini : IntervalIntegrable (fun t => omega t/t) volume 0 (radiusFactor a*epsilon)) :
    (∀ n, ‖x n‖ < R) ∧
    (∀ n, (g (x n),g (x (n+1))) ∈ pairCone M) ∧
    (∀ n, g (x n) ≠ 0 →
      0 < ⟪x (n+1)-x n,g (x (n+1))-g (x n)⟫_ℝ ∧
      0 < ‖g (x (n+1))-g (x n)‖^2) ∧
    ∀ n, V.value (g (x n),g (x (n+1))) ≤
      c^n*V.value (g (x 0),g (x 1))*
        Real.exp (((V.lipConstant*perturbationFactor a b)/c)*
          (omega (radiusFactor a*epsilon)+
            (∫ t in (0 : ℝ)..(radiusFactor a*epsilon),omega t/t)/(-Real.log gamma))) := by
  obtain ⟨hstay,hcone,hrough,hrec⟩ := C.local_bootstrap V hM x alpha halpha hstep hchoice
    hgamma.le hgamma1.le hx0 hx1 hcone0 hinit hball hsmall
  refine ⟨hstay,hcone,fun n hzero => C.secant_denominators (hstay n) (hstay (n+1))
    (halpha n) (hstep n) hzero,?_⟩
  apply BB.Dini.uniform_critical_rate_of_dini
    (fun n => V.value (g (x n),g (x (n+1)))) omega c
    (V.lipConstant*perturbationFactor a b) (radiusFactor a) gamma epsilon hc
    (fun n => (norm_nonneg _).trans (V.lower _ (hcone n)))
    (mul_nonneg V.lipConstant_nonneg (perturbationFactor_nonneg C.a_pos C.a_le_b))
    (radiusFactor_pos C.a_pos) hepsilon hgamma hgamma1 C.monotone C.nonnegative
    hinit hsmall hrec hDini

end BB.Local
