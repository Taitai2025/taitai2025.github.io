import BB.OperatorMoments

/-!
# Polynomial vectors and their scalar moment identities

These are actual polynomial evaluations in the algebra of bounded operators.
The identities connect the scalar state to norms and quadratic forms throughout
the algebraic cyclic subspace generated by a vector.
-/

namespace BB
noncomputable section
open Set
open scoped Polynomial
local notation "⟪" x ", " y "⟫" => @inner ℝ _ _ x y

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

def polynomialVector (A : E →L[ℝ] E) (x : E) (p : ℝ[X]) : E :=
  (Polynomial.aeval A p) x

def polynomialVectorLinear (A : E →L[ℝ] E) (x : E) : ℝ[X] →ₗ[ℝ] E where
  toFun := polynomialVector A x
  map_add' p q := by simp [polynomialVector]
  map_smul' c p := by simp [polynomialVector]

@[simp] lemma polynomial_vector_one (A : E →L[ℝ] E) (x : E) :
    polynomialVector A x 1 = x := by simp [polynomialVector]

lemma polynomial_vector_X_mul (A : E →L[ℝ] E) (x : E) (p : ℝ[X]) :
    polynomialVector A x (Polynomial.X*p) = A (polynomialVector A x p) := by
  simp [polynomialVector,ContinuousLinearMap.mul_apply]

lemma operator_iterate_symmetric (A : E →L[ℝ] E) (hA : A.toLinearMap.IsSymmetric)
    (k : ℕ) (x y : E) :
    ⟪(A : E → E)^[k] x,y⟫ = ⟪x,(A : E → E)^[k] y⟫ := by
  induction k generalizing x y with
  | zero => rfl
  | succ k ih =>
    rw [Function.iterate_succ_apply']
    calc
      ⟪A ((A : E → E)^[k] x),y⟫ = ⟪(A : E → E)^[k] x,A y⟫ := hA _ _
      _ = ⟪x,(A : E → E)^[k] (A y)⟫ := ih x (A y)
      _ = ⟪x,(A : E → E)^[k+1] y⟫ := by rw [Function.iterate_succ_apply]

lemma operator_polynomial_symmetric (A : E →L[ℝ] E) (hA : A.toLinearMap.IsSymmetric)
    (p : ℝ[X]) : (Polynomial.aeval A p).toLinearMap.IsSymmetric := by
  induction p using Polynomial.induction_on' with
  | h_add p q hp hq =>
    intro x y
    change ⟪(Polynomial.aeval A (p+q)) x,y⟫ = ⟪x,(Polynomial.aeval A (p+q)) y⟫
    simp only [map_add,ContinuousLinearMap.add_apply,inner_add_left,inner_add_right]
    exact congrArg₂ (fun u v : ℝ => u+v) (hp x y) (hq x y)
  | h_monomial k c =>
    intro x y
    change ⟪(Polynomial.aeval A (Polynomial.monomial k c)) x,y⟫ =
      ⟪x,(Polynomial.aeval A (Polynomial.monomial k c)) y⟫
    simp only [Polynomial.aeval_monomial,ContinuousLinearMap.mul_apply,
      ContinuousLinearMap.algebraMap_apply,ContinuousLinearMap.coe_pow,
      inner_smul_left,inner_smul_right,conj_trivial,smul_eq_mul]
    rw [operator_iterate_symmetric A hA]

lemma operator_moment_state_polynomial (A : E →L[ℝ] E) (hA : A.toLinearMap.IsSymmetric)
    (a b : ℝ) (hbounds : ∀ y : E, a*‖y‖^2 ≤ ⟪y,A y⟫ ∧ ⟪y,A y⟫ ≤ b*‖y‖^2)
    (x : E) (hx : x ≠ 0) (p : ℝ[X]) :
    (operatorMomentState A hA a b hbounds x hx).1 (p.toContinuousMapOn (Icc a b)) =
      ⟪x,polynomialVector A x p⟫/‖x‖^2 := by
  induction p using Polynomial.induction_on' with
  | h_add p q hp hq =>
    have he : (p+q).toContinuousMapOn (Icc a b) =
        p.toContinuousMapOn (Icc a b) + q.toContinuousMapOn (Icc a b) := by ext t; simp
    rw [he,map_add,hp,hq]
    simp only [polynomialVector,map_add,ContinuousLinearMap.add_apply,inner_add_right,add_div]
  | h_monomial k c =>
    rw [continuous_polynomial_monomial,map_smul,operator_moment_state_power]
    simp only [polynomialVector,Polynomial.aeval_monomial,ContinuousLinearMap.mul_apply,
      ContinuousLinearMap.algebraMap_apply,ContinuousLinearMap.coe_pow,inner_smul_right,smul_eq_mul]
    ring

lemma polynomial_vector_inner (A : E →L[ℝ] E) (hA : A.toLinearMap.IsSymmetric)
    (x : E) (p q : ℝ[X]) :
    ⟪polynomialVector A x p,polynomialVector A x q⟫ =
      ⟪x,polynomialVector A x (p*q)⟫ := by
  change ⟪(Polynomial.aeval A p) x,(Polynomial.aeval A q) x⟫ = _
  calc
    ⟪(Polynomial.aeval A p) x,(Polynomial.aeval A q) x⟫ =
        ⟪x,(Polynomial.aeval A p) ((Polynomial.aeval A q) x)⟫ :=
      operator_polynomial_symmetric A hA p x ((Polynomial.aeval A q) x)
    _ = _ := by simp only [polynomialVector,map_mul,ContinuousLinearMap.mul_apply]

lemma operator_polynomial_inner_moment (A : E →L[ℝ] E) (hA : A.toLinearMap.IsSymmetric)
    (a b : ℝ) (hbounds : ∀ y : E, a*‖y‖^2 ≤ ⟪y,A y⟫ ∧ ⟪y,A y⟫ ≤ b*‖y‖^2)
    (x : E) (hx : x ≠ 0) (p q : ℝ[X]) :
    ⟪polynomialVector A x p,polynomialVector A x q⟫ = ‖x‖^2 *
      (operatorMomentState A hA a b hbounds x hx).1
        (p.toContinuousMapOn (Icc a b) * q.toContinuousMapOn (Icc a b)) := by
  have he : p.toContinuousMapOn (Icc a b) * q.toContinuousMapOn (Icc a b) =
      (p*q).toContinuousMapOn (Icc a b) := by ext t; simp
  rw [he,operator_moment_state_polynomial,polynomial_vector_inner A hA]
  have hn : ‖x‖^2 ≠ 0 := (sq_pos_of_pos (norm_pos_iff.mpr hx)).ne'
  field_simp

lemma operator_polynomial_norm_moment (A : E →L[ℝ] E) (hA : A.toLinearMap.IsSymmetric)
    (a b : ℝ) (hbounds : ∀ y : E, a*‖y‖^2 ≤ ⟪y,A y⟫ ∧ ⟪y,A y⟫ ≤ b*‖y‖^2)
    (x : E) (hx : x ≠ 0) (p : ℝ[X]) :
    ‖polynomialVector A x p‖^2 = ‖x‖^2 *
      (operatorMomentState A hA a b hbounds x hx).1
        ((p.toContinuousMapOn (Icc a b))^2) := by
  simpa only [real_inner_self_eq_norm_sq,pow_two] using
    operator_polynomial_inner_moment A hA a b hbounds x hx p p

lemma operator_polynomial_form_moment (A : E →L[ℝ] E) (hA : A.toLinearMap.IsSymmetric)
    (a b : ℝ) (hbounds : ∀ y : E, a*‖y‖^2 ≤ ⟪y,A y⟫ ∧ ⟪y,A y⟫ ≤ b*‖y‖^2)
    (x : E) (hx : x ≠ 0) (p : ℝ[X]) :
    ⟪polynomialVector A x p,A (polynomialVector A x p)⟫ = ‖x‖^2 *
      (operatorMomentState A hA a b hbounds x hx).1
        (intervalCoordinate a b * (p.toContinuousMapOn (Icc a b))^2) := by
  rw [← polynomial_vector_X_mul,operator_polynomial_inner_moment A hA a b hbounds x hx]
  congr 2
  ext t
  simp only [ContinuousMap.mul_apply,ContinuousMap.pow_apply,Polynomial.toContinuousMapOn,
    Polynomial.toContinuousMap,ContinuousMap.coe_mk,Polynomial.eval_mul,Polynomial.eval_X,
    intervalCoordinate]
  ring

def polynomialCyclicSpace (A : E →L[ℝ] E) (x : E) : Submodule ℝ E :=
  LinearMap.range (polynomialVectorLinear A x)

lemma mem_polynomial_cyclic_space (A : E →L[ℝ] E) (x : E) :
    x ∈ polynomialCyclicSpace A x := ⟨1,polynomial_vector_one A x⟩

lemma polynomial_cyclic_space_invariant (A : E →L[ℝ] E) (x : E) :
    ∀ y ∈ polynomialCyclicSpace A x, A y ∈ polynomialCyclicSpace A x := by
  rintro y ⟨p,rfl⟩
  exact ⟨Polynomial.X*p,polynomial_vector_X_mul A x p⟩

end
end BB
